# ==============================================================================
# LeaderOS Environment Variables Example
# Sao chép file này thành .env trong root (hoặc .env tương ứng trong apps/api, apps/web)
# ==============================================================================

# Node Environment
NODE_ENV=development

# Database (PostgreSQL)
POSTGRES_USER=leaderos
POSTGRES_PASSWORD=leaderos
POSTGRES_DB=leaderos_app
POSTGRES_PORT=5432
DATABASE_URL=postgresql://leaderos:leaderos@localhost:5432/leaderos_app?schema=public

# Backend API (NestJS)
PORT=4000
CORS_ORIGIN=http://localhost:3000
SESSION_SECRET=leaderos-super-secret-session-key-min-32-chars

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
