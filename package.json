{
  "name": "leader-os-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @leaderos/* dev",
    "dev:api": "pnpm --filter @leaderos/api dev",
    "dev:web": "pnpm --filter @leaderos/web dev",
    "build": "pnpm --recursive --filter @leaderos/* build",
    "typecheck": "pnpm --recursive --filter @leaderos/* typecheck",
    "lint": "pnpm --recursive --filter @leaderos/* lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:migrate": "pnpm --filter @leaderos/api db:migrate",
    "db:generate": "pnpm --filter @leaderos/api db:generate"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.34.5"
}
